---
import Layout from '../layouts/Layout.astro';
---

<Layout title="HexDraft | LCU Real-Time">
  <main class="min-h-screen p-6 md:p-12 4xl:px-90 4xl:py-40 relative bg-[#020617] text-slate-200 overflow-hidden font-sans">

    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[800px] bg-purple-900/5 blur-[160px] rounded-full pointer-events-none"></div>

    <div class="flex justify-between relative z-10 mb-8">
        <a href="/" class="text-slate-500 hover:text-white transition-colors text-xs inline-block uppercase tracking-[0.2em] font-black group">
          <span class="inline-block transform group-hover:-translate-x-1 transition-transform">←</span> Inicio
        </a>

        <a href="/actualizar" class="text-slate-500 hover:text-white transition-colors text-xs inline-block uppercase tracking-[0.2em] font-black">
          Configuración <span class="text-purple-600">Sync</span> →
        </a>
    </div>

    <div id="lcu-status" class="w-fit mx-auto mb-10 flex items-center gap-3 py-2.5 px-4 bg-slate-900/80 border border-slate-800 rounded-sm relative z-10">
      <div id="status-indicator" class="w-2 h-2 rounded-full bg-red-600 shadow-[0_0_8px_rgba(220,38,38,0.5)]"></div>
      <span id="status-text" class="text-[10px] uppercase tracking-[0.2em] font-black text-slate-400">LCU Desconectado</span>
    </div>

    <div class="flex flex-row gap-6 w-full overflow-x-auto pb-4 justify-between items-start relative z-10">

        <div class="w-72 shrink space-y-4 min-w-[200px]">
            <h3 class="text-cyan-500 font-black text-xs uppercase tracking-widest border-b border-slate-800 pb-3 flex items-center gap-2">
                <span class="w-3 h-px bg-cyan-500"></span> Tu Equipo
            </h3>
            {Array(5).fill(0).map((_, i) => (
            <div id={`ally-slot-${i}`} class="h-24 bg-slate-900/40 border border-slate-800 border-l-4 border-l-cyan-600 flex items-center px-4 rounded-sm transition-all overflow-hidden relative group">
                <div class="relative w-16 h-16 bg-slate-950 border border-slate-800 overflow-hidden shrink-0 rounded-sm">
                <img src="" class="champ-img hidden w-full h-full object-cover z-10 relative" />
                <div class="absolute inset-0 flex items-center justify-center text-xl font-bold text-slate-800">?</div>
                </div>
                <div class="ml-4 flex flex-col min-w-0">
                <span class="summoner-name text-xs font-bold text-cyan-500 uppercase tracking-wide truncate w-full">Buscando...</span>
                <span class="champ-name text-[11px] text-slate-300 uppercase font-black italic tracking-wide truncate">Esperando Pick</span>
                </div>
                <div class="absolute right-1 mr-2 shrink-0">
                    <img class="role-icon w-8 h-8 hidden opacity-50 brightness-200" />
                </div>
            </div>
            ))}
        </div>

        <div class="flex-1 min-w-[750px]">
            <div class="bg-slate-900/50 border border-slate-800 p-8 rounded-sm backdrop-blur-md min-h-[600px] relative overflow-hidden shadow-2xl">
                <header class="mb-6 flex justify-between items-end border-b border-slate-800 pb-5">
                    <div>
                        <h2 id="view-title" class="text-xl font-black uppercase tracking-[0.3em] text-white italic">
                            ANALISIS <span class="text-purple-600">SUGERIDO</span>
                        </h2>
                        <p id="view-subtitle" class="text-[10px] text-slate-400 uppercase font-bold tracking-[0.2em] mt-2">
                            MOTOR DE RECOMENDACIÓN ACTIVO
                        </p>
                    </div>
                    <div class="text-[10px] text-purple-500 font-black uppercase tracking-[0.2em] bg-purple-950/20 px-3 py-1 border border-purple-900/30 rounded-sm">
                        Fase: <span id="phase" class="text-white">Picks</span>
                    </div>
                </header>

                <div id="recommendations-grid" class="grid grid-cols-5 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-3 max-w-fit w-full mx-auto relative transition-all duration-500">
                    <div class="absolute top-[15vh] left-1/2 -translate-x-1/2 text-center w-full">
                         <div class="w-10 h-10 border-2 border-slate-800 border-t-purple-600 rounded-full animate-spin mx-auto mb-4"></div>
                        <p class="text-slate-500 uppercase font-black tracking-[0.3em] text-[10px] animate-pulse">
                            Escaneando sesión de juego...
                        </p>
                    </div>
                </div>

                <div id="bans-grid" class="grid grid-cols-5 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-3 max-w-fit w-full mx-auto relative transition-all duration-500 hidden">
                </div>

                <div class="absolute bottom-6 left-0 w-full flex justify-center gap-12 z-50  pt-8 pb-2">
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" id="check-autopick" class="hidden peer">
                        <div class="w-5 h-5 border-2 border-slate-700 rounded-sm bg-slate-950 peer-checked:bg-purple-600 peer-checked:border-purple-600  transition-all flex items-center justify-center">
                            <span class="text-white text-xs opacity-0 peer-checked:opacity-100">✓</span>
                        </div>
                        <span class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500 group-hover:text-slate-300 transition-colors">Autopick</span>
                    </label>

                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" id="check-autoban" class="hidden peer">
                        <div class="w-5 h-5 border-2 border-slate-700 rounded-sm bg-slate-950 peer-checked:bg-red-600 peer-checked:border-red-600 transition-all flex items-center justify-center">
                            <span class="text-white text-xs opacity-0 peer-checked:opacity-100">✓</span>
                        </div>
                        <span class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500 group-hover:text-slate-300 transition-colors">Autoban</span>
                    </label>
                </div>

                <div id="build-view" class="hidden opacity-0 translate-y-4 transition-all duration-500 mb-12">
                    <div class="flex justify-between items-center mb-8 border-b border-slate-800 pb-6">
                        <button id="back-to-grid" class="text-[10px] text-slate-500 hover:text-white uppercase font-black tracking-widest transition-colors flex items-center gap-2">
                            <span class="text-lg">←</span> Volver al Análisis
                        </button>
                        <button id="import-lcu" class="bg-purple-600 hover:bg-purple-500 text-white text-[10px] font-black px-6 py-3 uppercase tracking-[0.2em] rounded-sm transition-all shadow-lg active:scale-95">
                            Aplicar al Cliente
                        </button>
                    </div>

                    <div class="grid grid-cols-12 gap-8">
                        <div id="runes-display" class="col-span-7 bg-black/30 p-6 border border-slate-800 rounded-sm">
                            <h4 class="text-[10px] text-cyan-500 font-black uppercase mb-6 tracking-[0.2em] flex items-center gap-2">
                                <span class="w-2 h-2 bg-cyan-500 rounded-full"></span> Configuración de Runas
                            </h4>
                            <div id="runes-content" class="grid grid-cols-4 gap-6"></div>
                        </div>

                        <div class="col-span-5 space-y-6">
                            <div id="items-display" class="bg-black/30 p-6 border border-slate-800 rounded-sm">
                                <h4 class="text-[10px] text-orange-500 font-black uppercase mb-6 tracking-[0.2em] flex items-center gap-2">
                                     <span class="w-2 h-2 bg-orange-500 rounded-full"></span> Build Sugerida
                                </h4>
                                <div id="items-content" class="flex flex-wrap gap-3"></div>
                            </div>
                            <div id="skills-display" class="bg-black/30 p-6 border border-slate-800 rounded-sm">
                                <h4 class="text-[10px] text-green-500 font-black uppercase mb-4 tracking-[0.2em] flex items-center gap-2">
                                     <span class="w-2 h-2 bg-green-500 rounded-full"></span> Secuencia Óptima
                                </h4>
                                <div id="skills-content" class="text-3xl font-black text-white italic tracking-tighter"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="w-72 shrink space-y-4 min-w-[200px] text-right">
        <h3 class="text-red-500 font-black text-xs uppercase tracking-widest border-b border-slate-800 pb-3 flex items-center justify-end gap-2">
           Enemigos <span class="w-3 h-px bg-red-500"></span>
        </h3>
        {Array(5).fill(0).map((_, i) => (
          <div id={`enemy-slot-${i}`} class="h-24 bg-slate-900/40 border border-slate-800 border-r-4 border-r-red-700 flex flex-row-reverse items-center px-4 rounded-sm transition-all overflow-hidden relative group">
            <div class="relative w-16 h-16 bg-slate-950 border border-slate-800 overflow-hidden shrink-0 rounded-sm">
              <img src="" class="champ-img hidden w-full h-full object-cover z-10 relative" />
              <div class="absolute inset-0 flex items-center justify-center text-xl font-bold text-slate-800">?</div>
            </div>
            <div class="mr-4 flex flex-col min-w-0">
              <span class="summoner-name text-xs font-bold text-red-500 uppercase  truncate w-full">Enemigo</span>
              <span class="champ-name text-[11px] text-slate-300 uppercase font-black italic tracking-wide truncate">Esperando Pick</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div id="reason-popup" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#020617]/95 backdrop-blur-xl hidden p-4 opacity-0 transition-opacity duration-300">
        <div class="bg-slate-900 border border-slate-700/50 max-w-lg w-full rounded-sm shadow-[0_0_50px_rgba(0,0,0,0.8)] relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-right from-transparent via-purple-600 to-transparent"></div>

            <div class="p-8">
                <div class="flex gap-6 items-start mb-8 border-b border-slate-800 pb-6">
                    <div class="relative shrink-0">
                        <div class="absolute -inset-1 bg-purple-600/20 blur-sm rounded-sm"></div>
                        <img id="popup-champ-img" src="" class="w-20 h-20 object-cover border border-slate-700 relative z-10" />
                    </div>

                    <div class="flex-1">
                        <div class="flex justify-between items-start">
                            <h4 id="popup-champ-name" class="text-3xl font-black text-white uppercase italic tracking-tighter leading-none">Nombre</h4>
                            <button id="close-popup" class="text-slate-500 hover:text-white transition-colors p-1 text-xl">✕</button>
                        </div>

                        <div class="mt-3 flex items-center gap-3">
                            <span id="popup-score-badge" class="px-3 py-1 bg-purple-600 text-white text-sm font-black italic rounded-sm">
                                SCORE: <span id="popup-score">0.0</span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <h5 class="text-[10px] text-slate-500 font-black uppercase tracking-[0.3em] mb-4">Métricas de Recomendación:</h5>
                    <ul id="popup-reasons-list" class="grid gap-3 max-h-[40vh] overflow-y-auto pr-2 custom-scrollbar">
                        </ul>
                </div>
            </div>
        </div>
    </div>
  </main>
</Layout>


<style>
  #recommendations-grid {
    content-visibility: auto;
  }
</style>


<script>
    import { base64 } from 'astro:schema';
    import { ENRICHED_DB } from '../lib/engine/dataProvider';
    import { getNameFromId, getSingleChampionBuild, getProcessedRecommendations, getProcessedBans } from '../lib/engine/engine';
    
    const IMG_BASE = "https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/champion-icons/";
    const POS_BASE = "https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/";
    const ITEM_IMG_BASE = "https://ddragon.leagueoflegends.com/cdn/16.9.1/img/item/";
    const CD_BASE = "https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/perk-images/";


    const posMapping = {
        "top": "icon-position-top.png",
        "jungle": "icon-position-jungle.png",
        "middle": "icon-position-middle.png",
        "mid": "icon-position-middle.png",
        "bottom": "icon-position-bottom.png",
        "utility": "icon-position-utility.png"
    };
    const RUNE_STYLE_MAP = {
        7200: "7200_domination.png",
        7201: "7201_precision.png",
        7202: "7202_sorcery.png",
        7203: "7203_whimsy.png",
        7204: "7204_resolve.png"
    };
    let isPolling = false;
    let pollingInterval = 2000;
    let lastPicksState = "";
    let lastImportedChampionId = 0;
    let isBuildViewActive = false;

    // CONTADOR Y DATOS DE SESIÓN
    let localTimer = 0;
    let timerInterval = null;
    let currentDraftData = null;

    let autoPickEnabled = localStorage.getItem('autoPick') === 'true';
    let autoBanEnabled = localStorage.getItem('autoBan') === 'true';

    const checkPick = document.getElementById('check-autopick');
    const checkBan = document.getElementById('check-autoban');

    if (checkPick) checkPick.checked = autoPickEnabled;
    if (checkBan) checkBan.checked = autoBanEnabled;

    checkPick?.addEventListener('change', (e) => {
        autoPickEnabled = e.target.checked;
        localStorage.setItem('autoPick', autoPickEnabled);
        console.log("Autopick guardado:", autoPickEnabled);
    });

    checkBan?.addEventListener('change', (e) => {
        autoBanEnabled = e.target.checked;
        localStorage.setItem('autoBan', autoBanEnabled);
        console.log("Autoban guardado:", autoBanEnabled);
    });

    let version = '';
    try {
          const res = await fetch('/api/game-version');
          if (res.ok) {
            const v = await res.json();
            version = v.short;
          }
      } catch (e) {
          console.error("Error detectando versión:", e);
      }


    let isUICleaned = false;
    function clearDraftUI() {

        if (isUICleaned) return;

        // 1. Reiniciar variables globales de control de estado
        isBuildViewActive = false;
        lastImportedChampionId = 0;
        lastPicksState = "";

        // 2. Controlar la visibilidad de los contenedores principales
        const recsGrid = document.getElementById('recommendations-grid');
        const bansGrid = document.getElementById('bans-grid');
        const buildView = document.getElementById('build-view'); // Asegúrate de usar el ID real de tu contenedor de builds
        const fase = document.getElementById('phase');
        const title = document.getElementById('view-title');
        const subtitle = document.getElementById('view-subtitle');

        // Restauramos el texto de la cabecera por defecto
        if (fase) fase.innerText = 'Lobby';

        // Ocultamos bans y builds, y nos aseguramos de que el grid principal esté visible
        if (bansGrid) bansGrid.classList.add('hidden');
       
        if (buildView) {
            buildView.classList.add('hidden', 'opacity-0');
            buildView.innerHTML = ""; 
        }

        if (recsGrid) {
            recsGrid.classList.remove('hidden');
            // Restablecemos las clases de grilla estándar por si el render de la build las alteró
            recsGrid.className = "grid grid-cols-4 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-7 gap-4 w-full relative min-h-[50vh]";


            title.innerHTML = 'HEX<span class="text-purple-500">DRAFT</span>';
            title.className = "text-xl font-black uppercase tracking-[0.3em] text-white italic";

            subtitle.innerText = 'MOTOR DE RECOMENDACIÓN ACTIVO';
            subtitle.className = "text-[10px] text-slate-400 uppercase font-bold tracking-[0.2em] mt-2";
            // Renderizamos un mensaje de espera elegante, centrado y estilizado
            recsGrid.innerHTML = `
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                    <div class="relative w-20 h-20 mb-8 group">
                        <div class="absolute inset-0 bg-purple-600/30 blur-xl rounded-full animate-pulse"></div>
                        
                        <div class="hextech-gem w-full h-full bg-gradient-to-br from-purple-400 via-purple-600 to-indigo-900 animate-[spin_10s_linear_infinite] relative z-10 shadow-[0_0_30px_rgba(168,85,247,0.5)]">
                            <div class="absolute inset-[2px] bg-[#020617] clip-hex flex items-center justify-center">
                                <div class="w-2/3 h-2/3 bg-purple-500/10 clip-hex animate-pulse"></div>
                            </div>
                        </div>
                        
                        <div class="absolute inset-[-10px] border border-purple-500/20 clip-hex animate-[spin_15s_linear_infinite_reverse]"></div>
                    </div>
            
                    <p class="text-slate-400 uppercase font-black tracking-[0.3em] text-xs animate-pulse max-w-xs">
                        Esperando Fase de Selección...
                    </p>
                    <p class="text-slate-600 text-[10px] mt-2 uppercase tracking-widest font-bold opacity-50">
                    Inicia una partida para poder comenzar
                    </p>
                </div>`;
        }

        // 3. Limpiar slots visuales de ambos equipos
        for (let i = 0; i < 5; i++) {
            resetSlot(`ally-slot-${i}`);
            resetSlot(`enemy-slot-${i}`);
        }
        isUICleaned = true;
        console.log("🧹 [UI] Estado del draft reiniciado por completo.");
    }

    function resetSlot(id) {
        const el = document.getElementById(id);
        if (!el) return;
        const img = el.querySelector('.champ-img');
        const cName = el.querySelector('.champ-name');
        const roleIcon = el.querySelector('.role-icon');
        if (img) img.classList.add('hidden');
        if (roleIcon) roleIcon.classList.add('hidden');
        if (cName) {
            cName.innerText = "Esperando...";
            cName.className = "text-[11px] text-slate-400 uppercase font-medium tracking-wider";
        }
    }

    function renderBuild(build, summoners, championName, championId) {
        const version = '16.9.1';
        const buildView = document.getElementById('build-view');
        if (!buildView || !build) {
            console.error("❌ [DEBUG] No se encontró build-view o el objeto build es nulo", build);
            return;
        }

        const { runes, items, skillOrder } = build;
        const styleIcons = {
            8000: "styles/7201_precision.png",
            8100: "styles/7200_domination.png",
            8200: "styles/7202_sorcery.png",
            8300: "styles/7203_whimsy.png",
            8400: "styles/7204_resolve.png"
        };
        const getCDIcon = (path) => {
            if (!path) return "";
            let cleanPath = path.toLowerCase().trim();
            if (cleanPath.includes('perk-images/')) {
                cleanPath = cleanPath.split('perk-images/')[1];
            }
            if (cleanPath.startsWith('/')) cleanPath = cleanPath.substring(1);

            return `https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/perk-images/${cleanPath}`;
        };
        const secondaryStyleId = runes.secondaryStyle?.id || runes.secondaryStyle;
        const secondaryIconPath = styleIcons[secondaryStyleId] || "styles/runesicon.png";
        buildView.innerHTML = `
            <div class="relative z-[300] flex flex-col gap-8 p-10 bg-[#020617] border border-slate-800 rounded-sm shadow-2xl animate-in fade-in slide-in-from-bottom-4 w-full backdrop-blur-md">

                <div class="flex items-center justify-between border-b border-slate-800 pb-8">
                    <div class="flex gap-8 items-center">
                        <div class="relative flex items-center">
                            <div class="w-20 h-20 bg-slate-900 border-2 border-purple-600 p-2 shadow-lg rounded-sm">
                                <img src="${getCDIcon(runes.keystone.icon)}" title="${runes.keystone.name}" class="w-full h-full object-contain" />
                            </div>
                            <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-slate-950 border border-slate-700 p-1.5 shadow-2xl rounded-sm">
                                <img src="${getCDIcon(secondaryIconPath)}" class="w-full h-full object-contain" />
                            </div>
                        </div>
                        <div>
                            <h3 class="text-white font-black text-3xl uppercase tracking-tighter italic">${championName}</h3>
                            <div class="flex gap-4 mt-2">
                                <p class="text-[10px] text-green-500 font-black uppercase tracking-[0.2em]">Secuencia: ${skillOrder}</p>
                                <span class="text-slate-800">|</span>
                                <p class="text-[10px] text-cyan-400 font-black uppercase tracking-[0.2em]">Protocolo Sincronizado</p>
                            </div>
                        </div>
                    </div>

                    <button id="btn-import-all" class="cursor-pointer px-10 py-5 bg-purple-600 hover:bg-purple-500 active:scale-95 text-white font-black uppercase text-[10px] tracking-[0.2em] rounded-sm transition-all shadow-xl border-none">
                        Importar al Cliente
                    </button>
                </div>

                <div class="flex flex-col gap-8">
                    <div class="space-y-6">
                        <div class="flex items-center gap-6">
                            <h4 class="text-[10px] text-purple-500 font-black uppercase tracking-[0.4em] italic pl-2">Ruta de Armamento</h4>
                            <div class="h-[1px] flex-1 bg-slate-800"></div>
                        </div>

                        <div class="bg-slate-900/40 border border-slate-800 p-12 rounded-sm relative">
                            <div class="flex flex-wrap items-center justify-center gap-6 relative z-10">
                                ${items.core.map((i, index) => `
                                    <div class="flex items-center">
                                        <div class="relative group/item" title="${i.name}">
                                            <div class="absolute -inset-1 bg-purple-600/20 opacity-0 group-hover/item:opacity-100 transition-all rounded-sm"></div>
                                            <div class="relative">
                                                <img src="https://ddragon.leagueoflegends.com/cdn/${version}/img/item/${i.id}.png"
                                                    class="w-14 h-14 border border-slate-700 rounded-sm shadow-2xl transition-transform group-hover/item:scale-105" />
                                                <div class="absolute -top-2 -right-2 bg-slate-950 border border-slate-700 text-[8px] font-black px-1.5 py-0.5 rounded-sm text-slate-400">
                                                    0${index + 1}
                                                </div>
                                            </div>
                                        </div>
                                        ${index < items.core.length - 1 ? `
                                            <div class="px-5 text-slate-800">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                            </div>
                                        ` : ''}
                                    </div>
                                `).join('')}

                                <div class="h-14 w-[1px] bg-slate-800 mx-8"></div>

                                <div class="flex flex-col items-center gap-2">
                                    <div class="relative group/boot" title="${items.boots.name}">
                                        <div class="absolute -inset-1 bg-cyan-400/10 opacity-0 group-hover/boot:opacity-100 transition-all rounded-sm"></div>
                                        <img src="https://ddragon.leagueoflegends.com/cdn/${version}/img/item/${items.boots.id}.png"
                                            class="w-14 h-14 border border-slate-700 rounded-sm relative z-10 shadow-2xl transition-transform group-hover/boot:-rotate-2" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
        document.getElementById('btn-import-all').onclick = async () => {
            const btn = document.getElementById('btn-import-all');
            btn.innerText = "Importando...";
            btn.disabled = true;

            try {
                await importAll(runes,items,summoners,championName,championId,skillOrder);
                btn.innerText = "¡Completado!";
                btn.classList.replace('bg-blue-600', 'bg-green-600');
            } catch (e) {
                btn.innerText = "Error";
                btn.classList.replace('bg-blue-600', 'bg-red-600');
            } finally {
                setTimeout(() => {
                    btn.disabled = false;
                }, 3000);
            }
        };
    }

    async function importAll(runes, buildItems, summoners, championName, championId, skillOrder) {
        console.log("🚀 Iniciando importación masiva para", championName, championId);
        try {
            const runePayload = {
                name: `HexDraft: ${championName}`,
                primaryStyleId: runes.primaryStyle,
                subStyleId: runes.secondaryStyle,
                selectedPerkIds: [
                    ...runes.selections.map(r => r.id || r),
                    ...runes.shards.map(s => s.id || s)
                ]
            };
            const itemPayload = {
                championId: championId,
                championName: championName,
                items: buildItems,
                skillOrder: skillOrder
            };
            const summonerPayload = {
                spell1Id: summoners[0].id,
                spell2Id: summoners[1].id
            };
            const [resRunes, resItems, resSpells] = await Promise.all([
                fetch('/api/set-runes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(runePayload)
                }),
                fetch('/api/set-items', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(itemPayload)
                }),
                fetch('/api/set-spells', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(summonerPayload)
                })
            ]);
            if (resRunes.ok && resItems.ok && resSpells.ok) {
                console.log("✅ Configuración completa aplicada");
            }
        } catch (e) {
            console.error("❌ Fallo en la importación:", e);
        }
    }

    async function updateDraftStatus() {
        if (isPolling) return;
        isPolling = true;
        try {
            const game_status = await fetch('/api/game-status');
            const { phase } = await game_status.json();

            const LcuStatus = document.getElementById('status-text');
            const LcuIndicador = document.getElementById('status-indicator');

            if (LcuStatus) {
                LcuStatus.innerText = "Conectado";
                LcuIndicador?.classList.replace('bg-red-600', 'bg-green-500')
            }
            
            if (phase === 'ChampSelect' || phase === 'ReadyCheck') {
                pollingInterval = 1500; // Fase crítica: rápido
                isUICleaned = false;
                await handleChampSelectLogic();
            } 
            else if (phase === 'InProgress'){
                pollingInterval = 30000; // Lobby/Cerrado: lento
                console.log("🎮 Partida en curso: Manteniendo Build en pantalla.");
                document.getElementById('recommendations-grid')?.classList.add('hidden');
                document.getElementById('bans-grid')?.classList.add('hidden');
                isBuildViewActive = true;
                
                if (isBuildViewActive) {
                  console.log("isBuildViewActive");
                    const buildView = document.getElementById('build-view');
                    buildView?.classList.remove('hidden', 'opacity-0');
                    buildView?.classList.add('opacity-100');
                    
                    const title = document.getElementById('view-title');
                    if (title && !title.innerHTML.includes("PARTIDA")) {
                        title.innerHTML = `ANÁLISIS <span class="text-purple-500">EN PARTIDA</span>`;
                    }
                }    
            } 
            else if (['None', 'Offline', 'Lobby', 'Matchmaking', 'EndOfGame'].includes(phase)) {
                pollingInterval = 10000; // Lobby/Cerrado: lento
                if (lastPicksState !== "") {
                    lastImportedChampionId = 0;
                    lastPicksState = "";
                }
                stopLocalTimer();
                clearDraftUI();
            }
        } catch (e) {
            console.error("❌ Error en ciclo:", e);
            pollingInterval = 10000;
        } finally {
            isPolling = false;
            setTimeout(updateDraftStatus, pollingInterval);
        }
    }


    async function handleChampSelectLogic() {
      const res = await fetch('/api/champ-select');
      if (!res.ok) {
          const status = document.getElementById('status-text');
          if (status) status.innerText = "Desconectado";
          clearDraftUI();
          return;
      }

      const data = await res.json();
      if (!data.inDraft) {
          stopLocalTimer();
          return;
      }
      currentDraftData = data;

      // Detectar mi turno activo (Pick o Ban)
      const myCellId = data.localPlayerCellId;
      const myActiveAction = data.actions?.flat().find(a =>
          a.actorCellId === myCellId && a.isInProgress && !a.completed
      );

      const isBanPhase = data.isBanPhase;

      const allActions = data.actions.flat();
      const bannedIds = allActions
        .filter(a => a.type === 'ban' && a.completed)
        .map(a => a.championId)
        .filter(id => id > 0);
      const pickedIds = [
        ...data.myTeam.map(p => p.championId),
        ...data.theirTeam.map(p => p.championId)
      ].filter(id => id > 0);
      const unavailableIds = [...new Set([...bannedIds, ...pickedIds])];
      
      const currentPicksState = `${isBanPhase}|${data.myTeam.map(p => `${p.championId}`).join(',')}|${data.theirTeam.map(p => `${p.championId}`).join(',')}`;


      console.log(data);
      if (currentPicksState !== lastPicksState) {
          lastPicksState = currentPicksState;

          // --- GESTIÓN DEL TIEMPO ---
          if (myActiveAction) {
              if (timerInterval) clearInterval(timerInterval);
              let rawTime = data.timer?.adjustedTimeLeftInPhase || 30000;
              localTimer = rawTime > 30000 ? rawTime - 5000 : rawTime;

              timerInterval = setInterval(() => {
                  if (localTimer > 0) {
                      localTimer -= 1000;
                      console.log(`⏱️ Tu Turno: ${localTimer / 1000}s`);
                      checkAutoActions(localTimer, myActiveAction, unavailableIds);
                  } else {
                      stopLocalTimer();
                  }
              }, 1000);
          } else {
              stopLocalTimer();
          }

          // --- ACTUALIZACIÓN DE UI Y MOTOR ---

          const cleanMyTeam = data.myTeam.map(p => p.championId || p.championPickIntent).filter(id => id !== 0);
          const cleanTheirTeam = data.theirTeam.map(p => p.championId || p.championPickIntent).filter(id => id !== 0);

          const resMe = await fetch('/api/me');
          const meData = await resMe.json();
          const myPlayer = data.myTeam.find(p => p.gameName === meData.summoner);
          const myRole = myPlayer?.assignedPosition?.toLowerCase() || "jungle";
          const fase = document.getElementById('phase');

          data.myTeam.forEach((p, i) => updateSlot(`ally-slot-${i}`, p));
          data.theirTeam.forEach((p, i) => updateSlot(`enemy-slot-${i}`, p));

          if (isBanPhase) {
              const bansGrid = document.getElementById('bans-grid');
              if (bansGrid?.classList.contains('hidden')) showBans();
              const recs = getProcessedRecommendations(cleanMyTeam, cleanTheirTeam, unavailableIds, myRole);

              const banRecs = getProcessedBans(recs).filter(b => !unavailableIds.includes(b.id));
              renderBans(getProcessedBans(banRecs));
              if (fase) fase.innerText = 'Bans';
          } else {
              const grid = document.getElementById('recommendations-grid');
              if (grid?.classList.contains('hidden')) showRecomendaciones();
              if (fase) fase.innerText = 'Picks';

              if (myPlayer && myPlayer.championId !== 0) {
                  if (myPlayer.championId !== lastImportedChampionId) {
                      const pickData = getSingleChampionBuild(myPlayer.championId);
                      if (pickData) {
                          isBuildViewActive = true;
                          lastImportedChampionId = myPlayer.championId;
                          importAll(pickData.build.runes, pickData.build.items, pickData.build.summoners, pickData.name, myPlayer.championId, pickData.build.skillOrder);
                          showBuildView(pickData.name);
                          renderBuild(pickData.build, pickData.build.summoners, pickData.name, myPlayer.championId);
                      }
                  }
              } else {
                  isBuildViewActive = false;
                  console.log(unavailableIds);
                  const recs = getProcessedRecommendations(cleanMyTeam, cleanTheirTeam, unavailableIds, myRole);
                  renderGrid(recs.slice(0, 20));
              }
          }
      }
    }

    async function executeLcuAction(actionId, championId) {
      try {
          await fetch('/api/execute-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ actionId, championId, completed: true })
          });
          console.log(`✅ Acción automática completada: ${championId}`);
      } catch (e) {
          console.error("❌ Error en auto-acción:", e);
      }
  }

    async function checkAutoActions(currentTime, activeAction, unavailableIds) {
      // Disparamos a los 3.5s para asegurar que el LCU procese antes del fin de fase
      if (currentTime <= 4000 && activeAction) {
          
          const cleanMyTeam = currentDraftData.myTeam.map(p => p.championId || p.championPickIntent).filter(id => id !== 0);
          const cleanTheirTeam = currentDraftData.theirTeam.map(p => p.championId || p.championPickIntent).filter(id => id !== 0);

          const resMe = await fetch('/api/me');
          const meData = await resMe.json();
          const myPlayer = currentDraftData.myTeam.find(p => p.gameName === meData.summoner);
          const myRole = myPlayer?.assignedPosition?.toLowerCase() || "jungle";

          if (activeAction.type === 'ban' && autoBanEnabled) {
              const recs = getProcessedRecommendations(cleanMyTeam, cleanTheirTeam, unavailableIds, myRole);
              const bestBan = getProcessedBans(recs).filter(b => !unavailableIds.includes(b.id))[0];
              if (bestBan) await executeLcuAction(activeAction.id, bestBan.id);
          }
          else if (activeAction.type === 'pick' && autoPickEnabled) {
              const bestPick = getProcessedRecommendations(cleanMyTeam, cleanTheirTeam, unavailableIds, myRole)[0];              
              if (bestPick) await executeLcuAction(activeAction.id, bestPick.id);
          }
          stopLocalTimer();
      }
  }

  function stopLocalTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = null;
      localTimer = 0;
  }

    function renderGrid(recs) {
        const container = document.getElementById('recommendations-grid');
        if (!container) return;

        container.className = "grid grid-cols-5 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-x-2 gap-y-4 pb-4 max-w-fit w-full mx-auto relative transition-all duration-500";
        container.innerHTML = recs.map(r => {
            const scoreColor = r.score >= 8 ? 'text-green-400' : (r.score >= 6 ? 'text-yellow-400' : 'text-red-400');

            return `
                <div class="recommendation-item group relative w-20 h-20 bg-slate-900 border border-blue-900/30 rounded-md hover:border-blue-500  cursor-pointer"
                    data-name="${r.name}" data-reasons="${r.reasons.join('|')}" data-score="${r.score.toFixed(1)}">
                    <img src="${IMG_BASE}${r.id}.png" loading="lazy" class="w-full h-full object-cover rounded-md group-hover:opacity-40" />
                    <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 z-20">
                        <span class="text-[13px] font-black px-2 py-1 rounded rounded-full border border-slate-900 bg-slate-800 ${scoreColor} shadow-md shadow-black/50">
                            ${r.score.toFixed(1)}
                        </span>
                    </div>
                </div>`;
        }).join('');

        attachReasonEvents();
    }

    function renderBans(recs){
        const container = document.getElementById('bans-grid');
        if (!container) return;

        container.className = "grid grid-cols-5 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-2 max-w-fit w-full mx-auto relative transition-all duration-500";
        container.innerHTML = recs.map(r => {
            const scoreColor = r.score >= 8 ? 'text-green-400' : (r.score >= 6 ? 'text-yellow-400' : 'text-red-400');

            return `
                <div class="bans-item group relative w-20 h-20 bg-slate-900 border border-blue-900/30 rounded-md hover:border-blue-500 transition-all cursor-pointer"
                    data-name="${r.name}" data-reasons="Counter peligroso del meta sugerido" data-score="${r.score.toFixed(1)}">
                    <img src="${IMG_BASE}${r.id}.png" class="w-full h-full object-cover rounded-md group-hover:opacity-40 transition-opacity" />
                    <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 z-20">
                        <span class="text-[13px] font-black px-2 py-1 rounded rounded-full border border-slate-900 bg-slate-800 ${scoreColor} shadow-md shadow-black/50">
                            ${r.score.toFixed(1)}
                        </span>
                    </div>
                </div>`;
        }).join('');

        attachReasonEvents();
    }

    function updateSlot(id, player) {
        const el = document.getElementById(id);
        if (!el) return;

        const img = el.querySelector('.champ-img');
        const sName = el.querySelector('.summoner-name');
        const cName = el.querySelector('.champ-name');
        const roleIcon = el.querySelector('.role-icon');
        if (sName) sName.innerText = player.displayName || player.gameName || "Invocador";

        const cid = player.championId || player.championPickIntent;
        if (cid > 0) {
            if (img) {
                img.src = `${IMG_BASE}${cid}.png`;
                img.classList.remove('hidden');
                img.style.opacity = player.championId === 0 ? "0.5" : "1";
            }
            if (cName) {
                cName.innerText = player.championId === 0 ? "Eligiendo..." : "Bloqueado";
                cName.className = `text-[10px] uppercase font-black ${player.championId === 0 ? 'text-slate-500' : 'text-white'}`;
            }
        }

        const pos = player.assignedPosition?.toLowerCase();
        if (roleIcon && posMapping[pos]) {
            roleIcon.src = `${POS_BASE}${posMapping[pos]}`;
            roleIcon.classList.remove('hidden');
            roleIcon.style.filter = "brightness(0) invert(1)";
        }
    }

    function attachReasonEvents() {
        const items = document.querySelectorAll('.recommendation-item');
        const popup = document.getElementById('reason-popup');

        items.forEach(item => {
            item.onclick = () => {
                const name = item.getAttribute('data-name');
                const score = parseFloat(item.getAttribute('data-score') || "0");
                const reasons = (item.getAttribute('data-reasons') || "").split('|');
                const champId = item.querySelector('img')?.getAttribute('src')?.split('/').pop()?.split('.')[0];

                // Elementos del DOM
                const nameEl = document.getElementById('popup-champ-name');
                const scoreEl = document.getElementById('popup-score');
                const scoreBadge = document.getElementById('popup-score-badge');
                const listEl = document.getElementById('popup-reasons-list');
                const imgEl = document.getElementById('popup-champ-img') as HTMLImageElement;

                if (nameEl) nameEl.innerText = name;
                if (scoreEl) scoreEl.innerText = score.toFixed(1);
                if (imgEl && champId) imgEl.src = `https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/champion-icons/${champId}.png`;

                // Color dinámico según Score
                if (scoreBadge) {
                    const colorClass = score >= 8 ? 'bg-green-600' : score >= 6 ? 'bg-yellow-600' : 'bg-red-700';
                    scoreBadge.className = `px-3 py-1 ${colorClass} text-white text-sm font-black italic rounded-sm transition-colors duration-500`;
                }

                if (listEl) {
                    listEl.innerHTML = reasons.map(res => {
                        // Detectar si es aviso negativo o bono positivo
                        const isNegative = res.toLowerCase().includes("aviso") || res.toLowerCase().includes("peligro") || res.toLowerCase().includes("débil");
                        const icon = isNegative ? "⚠" : "▹";
                        const border = isNegative ? "border-red-900/30 bg-red-950/5" : "border-slate-800 bg-slate-950/20";
                        const textColor = isNegative ? "text-red-400" : "text-slate-300";

                        return `
                            <li class="flex items-center gap-4 p-3 border ${border} rounded-sm group/li transition-all hover:border-slate-600">
                                <span class="text-lg ${isNegative ? 'text-red-600' : 'text-purple-500'} font-bold">${icon}</span>
                                <span class="text-[11px] uppercase font-bold tracking-wider ${textColor}">${res}</span>
                            </li>
                        `;
                    }).join('');
                }

                // Animación de entrada
                if (popup) {
                    popup.classList.remove('hidden');
                    setTimeout(() => popup.classList.replace('opacity-0', 'opacity-100'), 10);
                }
            };
        });
    }

    function showRecomendaciones() {
        isBuildViewActive = false;
        const gridbans = document.getElementById('bans-grid');
        const gridRecomendations = document.getElementById('recommendations-grid');
        const buildView = document.getElementById('build-view');
        const title = document.getElementById('view-title');
        const subtitle = document.getElementById('view-subtitle');
        gridbans?.classList.add('hidden');
        title.innerText = `Recomendaciones`;
        subtitle.innerText = "Basado en composiciones y counters";

        buildView.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            gridbans?.classList.add('hidden');
            buildView.classList.add('hidden');
            gridRecomendations.classList.remove('hidden');
            setTimeout(() => {
                gridRecomendations.classList.remove('opacity-0', 'translate-y-4');
                gridRecomendations.classList.add('opacity-100', 'translate-y-0');
            }, 50);
        }, 300);
    }

    function showBans() {
        isBuildViewActive = false;
        const gridbans = document.getElementById('bans-grid');
        const gridRecomendations = document.getElementById('recommendations-grid');
        const buildView = document.getElementById('build-view');
        const title = document.getElementById('view-title');
        const subtitle = document.getElementById('view-subtitle');

        title.innerHTML = 'Bans<span class="text-purple-500"> Recomendados</span>';

        subtitle.innerText = "Basado en tus counters";

        buildView?.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            gridRecomendations?.classList.add('hidden');
            buildView?.classList.add('hidden');
            gridbans?.classList.remove('hidden');

            setTimeout(() => {
                gridbans?.classList.remove('opacity-0', 'translate-y-4');
                gridbans?.classList.add('opacity-100', 'translate-y-0');
            }, 50);
        }, 300);
    }

    function showBuildView(championName) {
        const grid = document.getElementById('recommendations-grid');
        const buildView = document.getElementById('build-view');
        const title = document.getElementById('view-title');
        const subtitle = document.getElementById('view-subtitle');

        title.innerHTML = `Build: <span class="text-purple-500"> ${championName}</span>`;

        subtitle.innerText = "Sincronizado con meta actual";

        grid.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            grid.classList.add('hidden');
            buildView.classList.remove('hidden');
            setTimeout(() => {
                buildView.classList.remove('opacity-0', 'translate-y-4');
                buildView.classList.add('opacity-100', 'translate-y-0');
            }, 50);
        }, 300);
    }

    const closeBtn = document.getElementById('close-popup');
    if (closeBtn) {
        closeBtn.onclick = () => {
            const popup = document.getElementById('reason-popup');
            if (popup) popup.classList.add('hidden');
        };
    }

    window.addEventListener('click', (event) => {
        const popup = document.getElementById('reason-popup');
        if (event.target === popup && popup) {
            popup.classList.add('hidden');
        }
    });
    console.log("🚀 HexDraft UI Ready");
    updateDraftStatus();
</script>


