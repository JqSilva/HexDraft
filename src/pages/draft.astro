---
import Layout from '../layouts/Layout.astro';
---

<Layout title="HexDraft | LCU Real-Time">
  <main class="min-h-screen p-6 md:p-12 4xl:px-90 4xl:py-40 relative bg-[#010a13] text-slate-200">
    <a href="/" class="text-white/50 hover:text-white transition-colors text-sm mb-8 inline-block uppercase tracking-widest font-bold">
      ← Volver al Inicio
    </a>

    <div id="lcu-status" class="w-fit mx-auto mb-6 text-center py-2 px-3 bg-slate-900/80 border border-slate-800 rounded-sm">
      <span class="text-xs uppercase tracking-widest font-bold text-slate-500">Estado del Cliente: </span>
      <span id="status-text" class="text-xs uppercase tracking-widest font-bold text-red-500">Desconectado</span>
    </div>

    <div class="grid grid-cols-12 gap-8">
      
        <div class="col-span-12 lg:col-span-3 space-y-4">
            <h3 class="text-blue-400 font-bold uppercase tracking-tighter border-b border-blue-900 pb-2">Tu Equipo</h3>
            {Array(5).fill(0).map((_, i) => (
            <div id={`ally-slot-${i}`} class="h-24 bg-blue-900/10 border border-blue-900/30 flex items-center px-4 rounded-sm transition-all overflow-hidden relative group">
                <div class="relative w-16 h-16 bg-slate-800 border border-blue-500/30 overflow-hidden">
                <img src="" class="champ-img hidden w-full h-full object-cover z-10 relative" />
                <div class="absolute inset-0 flex items-center justify-center text-xl font-bold text-blue-500/20">?</div>
                </div>
                <div class="ml-4 flex flex-col">
                <span class="summoner-name text-xs font-bold text-blue-400 uppercase tracking-tight truncate w-32">Buscando...</span>
                <span class="champ-name text-[10px] text-slate-500 uppercase font-black">Esperando Pick</span>
                </div>
                <div class="absolute right-1 mr-4">
                    <img class="role-icon w-10 h-10 hidden" />
                </div>
            </div>
            ))}
        </div>

        <div class="col-span-12 lg:col-span-6">
            <div class="bg-slate-900/50 border border-slate-800 p-6 rounded-sm backdrop-blur-md min-h-[600px] relative overflow-hidden">
                <header class="mb-8 flex justify-between items-end border-b border-slate-800 pb-4">
                    <div>
                        <h2 id="view-title" class="text-2xl font-black text-white uppercase italic tracking-tighter">Recomendaciones</h2>
                        <p id="view-subtitle" class="text-[10px] text-slate-500 uppercase">Basado en composiciones y counters</p>
                    </div>
                    <div class="text-xs text-blue-400 font-bold uppercase tracking-widest">
                        Fase: <span id="timer-display">00</span>
                    </div>
                </header>

                <div id="recommendations-grid" class="grid grid-cols-5 md:grid-cols-6 lg:grid-cols-10 gap-2 max-w-fit w-full mx-auto relative transition-all duration-500">
                    <p class="absolute top-[20vh] left-1/2 -translate-x-1/2 -translate-y-1/2 text-slate-600 uppercase font-bold animate-pulse text-center w-70">
                        Esperando Fase de Selección...
                    </p>
                </div>

                <div id="build-view" class="hidden opacity-0 translate-y-4 transition-all duration-500">
                    <div class="flex justify-between items-start mb-6">
                        <button id="back-to-grid" class="text-[10px] text-slate-500 hover:text-white uppercase font-bold transition-colors">
                            ← Volver a Recomendaciones
                        </button>
                        <button id="import-lcu" class="bg-blue-600 hover:bg-blue-500 text-white text-[10px] font-black px-4 py-2 uppercase tracking-tighter transition-all shadow-lg shadow-blue-900/20">
                            Importar al Cliente (LCU)
                        </button>
                    </div>

                    <div class="grid grid-cols-12 gap-6">
                        <div id="runes-display" class="col-span-12 md:col-span-7 bg-black/40 p-4 border border-slate-800">
                            <h4 class="text-[10px] text-blue-400 font-bold uppercase mb-4 tracking-widest">Configuración de Runas</h4>
                            <div id="runes-content" class="grid grid-cols-4 gap-4">
                                </div>
                        </div>

                        <div class="col-span-12 md:col-span-5 space-y-6">
                            <div id="items-display" class="bg-black/40 p-4 border border-slate-800">
                                <h4 class="text-[10px] text-orange-400 font-bold uppercase mb-4 tracking-widest">Build Sugerida</h4>
                                <div id="items-content" class="flex flex-wrap gap-2">
                                    </div>
                            </div>
                            <div id="skills-display" class="bg-black/40 p-4 border border-slate-800">
                                <h4 class="text-[10px] text-green-400 font-bold uppercase mb-2 tracking-widest">Orden de Habilidades</h4>
                                <div id="skills-content" class="text-xl font-black text-white italic tracking-tighter">
                                    </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

      <div class="col-span-12 lg:col-span-3 space-y-4 text-right">
        <h3 class="text-red-400 font-bold uppercase tracking-tighter border-b border-red-900 pb-2">Enemigos</h3>
        {Array(5).fill(0).map((_, i) => (
          <div id={`enemy-slot-${i}`} class="h-24 bg-red-900/10 border border-red-900/30 flex flex-row-reverse items-center px-4 rounded-sm transition-all overflow-hidden relative group">
            <div class="relative w-16 h-16 bg-slate-800 border border-red-500/30 overflow-hidden">
              <img src="" class="champ-img hidden w-full h-full object-cover z-10 relative" />
              <div class="absolute inset-0 flex items-center justify-center text-xl font-bold text-red-500/20">?</div>
            </div>
            <div class="mr-4 flex flex-col">
              <span class="summoner-name text-xs font-bold text-red-400 uppercase tracking-tight truncate w-32">Enemigo</span>
              <span class="champ-name text-[10px] text-slate-500 uppercase font-black">Esperando Pick</span>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div id="reason-popup" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 hidden p-4">
        <div class="bg-[#010a13] border border-blue-900/50 p-6 max-w-sm w-full rounded-sm shadow-2xl">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h4 id="popup-champ-name" class="text-xl font-black text-white uppercase italic">Nombre</h4>
                    <p class="text-xs text-blue-400 font-bold uppercase tracking-widest">Score: <span id="popup-score">0.0</span></p>
                </div>
                <button id="close-popup" class="text-slate-500 hover:text-white font-bold">✕</button>
            </div>
            <ul id="popup-reasons-list" class="space-y-3">
                </ul>
        </div>
    </div>
  </main>
</Layout>

<script>
    import { getProcessedRecommendations } from '../lib/engine/engine';
    import { ENRICHED_DB } from '../lib/engine/dataProvider';
    import { getNameFromId } from '../lib/engine/engine';


    const IMG_BASE = "https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/champion-icons/";
    const POS_BASE = "https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/";
    const ITEM_IMG_BASE = "https://ddragon.leagueoflegends.com/cdn/16.9.1/img/item/";
    const CD_BASE = "https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/perk-images/";

    const posMapping = {
        "top": "icon-position-top.png",
        "jungle": "icon-position-jungle.png",
        "middle": "icon-position-middle.png",
        "mid": "icon-position-middle.png",
        "bottom": "icon-position-bottom.png",
        "utility": "icon-position-utility.png"
    };

    const RUNE_STYLE_MAP = {
        7200: "7200_domination.png",
        7201: "7201_precision.png",
        7202: "7202_sorcery.png",
        7203: "7203_whimsy.png", // Inspiración
        7204: "7204_resolve.png"
    };

    let lastPicksState = "";

    /**
     * Limpia profundamente la interfaz y resetea estados
     */
    function clearDraftUI() {
        console.log("🧹 [UI] Limpiando interfaz completa...");
        showRecomendaciones(); 
        const container = document.getElementById('recommendations-grid');
        if (container) {
            container.innerHTML = `
                <p class="absolute top-[20vh] left-1/2 -translate-x-1/2 -translate-y-1/2 text-slate-600 uppercase font-bold animate-pulse text-center w-70">
                    Esperando Fase de Selección...
                </p>`;
        }
        
        // Limpiar slots visuales
        for (let i = 0; i < 5; i++) {
            resetSlot(`ally-slot-${i}`);
            resetSlot(`enemy-slot-${i}`);
        }
        
        lastPicksState = "";
    }

    function resetSlot(id) {
        const el = document.getElementById(id);
        if (!el) return;
        const img = el.querySelector('.champ-img');
        const cName = el.querySelector('.champ-name');
        const roleIcon = el.querySelector('.role-icon');
        if (img) img.classList.add('hidden');
        if (roleIcon) roleIcon.classList.add('hidden');
        if (cName) {
            cName.innerText = "Esperando...";
            cName.className = "text-[10px] text-slate-500 uppercase font-black";
        }
    }

    function renderBuild(championName) {
        const champData = ENRICHED_DB[championName];
        if (!champData?.buildData) return;

        const { runes, items, skills } = champData.buildData;

        // --- RENDER SIMPLIFICADO ---
        const buildView = document.getElementById('build-view');
        if (!buildView) return;

        buildView.innerHTML = `
            <div class="flex flex-col gap-6 p-4 bg-black/20 rounded-sm border border-slate-800">
                
                <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                    <div class="flex gap-4 items-center">
                        <div class="relative">
                            proximamente...
                        </div>
                        <div>
                            <span class="block text-xs font-black text-white uppercase tracking-tighter">Configuración Meta</span>
                            <span class="text-[10px] text-blue-400 font-bold uppercase tracking-widest">WR: ${champData.meta.winRate}%</span>
                        </div>
                    </div>
                    
                    <div class="text-right">
                        <span class="block text-[10px] text-slate-500 uppercase font-bold">Prioridad</span>
                        <span class="text-lg font-black text-green-400 italic">proximamente</span>
                    </div>
                </div>

                <div>
                    <span class="text-[10px] text-slate-500 uppercase font-black mb-3 block tracking-widest">Core Items (Power Spike)</span>
                    <div class="flex gap-3">
                        proximamente
                        <div class="flex items-center ml-2">
                            <span class="text-slate-700 font-black text-xl">+</span>
                        </div>
                    </div>
                </div>

                <button id="import-lcu" class="w-full mt-2 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold uppercase text-xs tracking-widest transition-all">
                    Importar Runas al Cliente
                </button>
            </div>
        `;
        
        // Re-vincular el evento del botón (lo haremos dsp)
    }

    async function updateDraftStatus() {
        let isBuildViewActive = false;
        try {
            const res = await fetch('/api/champ-select');
            const status = document.getElementById('status-text');

            if (!res.ok) {
                if (status) {
                    status.innerText = "Desconectado";
                    status.className = "text-xs uppercase tracking-widest font-bold text-red-500";
                }
                clearDraftUI();
                setTimeout(updateDraftStatus, 5000);
                return;
            }

            if (status) {
                status.innerText = "Conectado";
                status.classList.replace("text-red-500", "text-green-500");
            }
            const data = await res.json();
            
            
            if (data.inDraft) {
                const currentPicksState = data.myTeam.map(p => `${p.championId}-${p.championPickIntent}`).join(',') + '|' + 
                                        data.theirTeam.map(p => `${p.championId}-${p.championPickIntent}`).join(',');

                if (currentPicksState !== lastPicksState) {
                    console.group("🎮 [DRAFT UPDATE] Cambio detectado");
                    lastPicksState = currentPicksState;

                    // 1. Limpieza de IDs para el motor
                    const cleanMyTeam = data.myTeam
                        .map(p => p.championId || p.championPickIntent)
                        .filter(id => id !== 0);

                    const cleanTheirTeam = data.theirTeam
                        .map(p => p.championId || p.championPickIntent)
                        .filter(id => id !== 0);

                    // 2. Obtener mi posición
                    const resMe = await fetch('/api/me');
                    const meData = await resMe.json();
                    const myPlayer = data.myTeam.find(p => p.gameName === meData.summoner);

                    const myPos = myPlayer?.assignedPosition?.toLowerCase() || "jungle";

                    console.log(myPlayer)
                    if (myPlayer){
                        if (myPlayer.championId !== 0 && !isBuildViewActive) {
                            const champname = getNameFromId(myPlayer.championId);
                            renderBuild(champname);
                            showBuildView(champname || "Desconocido", );
                            isBuildViewActive = true;
                        }
                    }

                    // 3. Procesar Recomendaciones
                    const recs = getProcessedRecommendations(cleanMyTeam, cleanTheirTeam, myPos);
                    console.log("📊 Recomendaciones generadas:", recs.length);
                    
                    renderGrid(recs.slice(0, 20));

                    // 4. Actualizar slots
                    data.myTeam.forEach((p, i) => updateSlot(`ally-slot-${i}`, p));
                    data.theirTeam.forEach((p, i) => updateSlot(`enemy-slot-${i}`, p));
                    
                    console.groupEnd();
                }
            } else {
                if (lastPicksState !== "") {
                    console.log("🏳️ El draft ha terminado o se ha cancelado.");
                    isBuildViewActive = false;
                    clearDraftUI();
                }
            }
        } catch (e) {
            console.error("❌ Error en ciclo de draft:", e);
        } finally {
            setTimeout(updateDraftStatus, 2000);
        }
    }

    function renderGrid(recs) {
        const container = document.getElementById('recommendations-grid');
        if (!container) return;
        
        container.className = "grid grid-cols-5 sm:grid-cols-6 lg:grid-cols-10 gap-3 w-full justify-items-center content-start";
        container.innerHTML = recs.map(r => {
            const scoreColor = r.score >= 8 ? 'text-green-400' : (r.score >= 6 ? 'text-yellow-400' : 'text-red-400');
            const reasonsStr = r.reasons.join('|');

            return `
                <div class="recommendation-item group relative w-14 h-14 bg-slate-900 border border-blue-900/30 rounded-md hover:border-blue-500 transition-all cursor-pointer"
                    data-name="${r.name}" data-reasons="${r.reasons.join('|')}" data-score="${r.score.toFixed(1)}">
                    <img src="${IMG_BASE}${r.id}.png" class="w-full h-full object-cover rounded-md group-hover:opacity-40 transition-opacity" />
                    <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 z-20">
                        <span class="text-[9px] font-black px-1 py-0.5 rounded border border-slate-900 bg-slate-800 ${scoreColor} shadow-md shadow-black/50">
                            ${r.score.toFixed(1)}
                        </span>
                    </div>
                </div>`;
        }).join('');

        attachReasonEvents();
    }

    function updateSlot(id, player) {
        const el = document.getElementById(id);
        if (!el) return;

        const img = el.querySelector('.champ-img');
        const sName = el.querySelector('.summoner-name');
        const cName = el.querySelector('.champ-name');
        const roleIcon = el.querySelector('.role-icon');

        if (sName) sName.innerText = player.displayName || player.gameName || "Invocador";

        const cid = player.championId || player.championPickIntent;

        if (cid > 0) {
            if (img) {
                img.src = `${IMG_BASE}${cid}.png`;
                img.classList.remove('hidden');
                img.style.opacity = player.championId === 0 ? "0.5" : "1";
            }
            if (cName) {
                cName.innerText = player.championId === 0 ? "Eligiendo..." : "Bloqueado";
                cName.className = `text-[10px] uppercase font-black ${player.championId === 0 ? 'text-slate-500' : 'text-white'}`;
            }
        }

        const pos = player.assignedPosition?.toLowerCase();
        if (roleIcon && posMapping[pos]) {
            roleIcon.src = `${POS_BASE}${posMapping[pos]}`;
            roleIcon.classList.remove('hidden');
            roleIcon.style.filter = "brightness(0) invert(1)";
        }
    }

    function attachReasonEvents() {
        const items = document.querySelectorAll('.recommendation-item');
        const popup = document.getElementById('reason-popup');
        
        items.forEach(item => {
            item.onclick = () => {
                const nameEl = document.getElementById('popup-champ-name');
                const scoreEl = document.getElementById('popup-score');
                const listEl = document.getElementById('popup-reasons-list');
                
                if (nameEl) nameEl.innerText = item.getAttribute('data-name');
                if (scoreEl) scoreEl.innerText = item.getAttribute('data-score');
                
                const reasons = (item.getAttribute('data-reasons') || "").split('|');
                if (listEl) {
                    listEl.innerHTML = reasons.map(res => `
                        <li class="flex items-start gap-2 text-sm text-slate-300 border-l-2 border-blue-500/30 pl-2 py-1">
                            <span class="text-blue-500 font-bold">»</span> ${res}
                        </li>
                    `).join('');
                }
                if (popup) popup.classList.remove('hidden');
            };
        });
    }


    function showRecomendaciones() {
        const gridRecomendations = document.getElementById('recommendations-grid');
        const buildView = document.getElementById('build-view');
        const title = document.getElementById('view-title');
        const subtitle = document.getElementById('view-subtitle');
        console.log("🔙 Volviendo a Recomendaciones");
        // Cambiar textos del header
        title.innerText = `Recomendaciones`;
        subtitle.innerText = "Basado en composiciones y counters";

        // Animación de salida y entrada
        buildView.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            buildView.classList.add('hidden');
            gridRecomendations.classList.remove('hidden');
            setTimeout(() => {
                gridRecomendations.classList.remove('opacity-0', 'translate-y-4');
                gridRecomendations.classList.add('opacity-100', 'translate-y-0');
            }, 50);
        }, 300);
    }


    function showBuildView(championName) {
        const grid = document.getElementById('recommendations-grid');
        const buildView = document.getElementById('build-view');
        const title = document.getElementById('view-title');
        const subtitle = document.getElementById('view-subtitle');

        // Cambiar textos del header
        title.innerText = `Build: ${championName}`;
        subtitle.innerText = "Sincronizado con meta actual";

        // Animación de salida y entrada
        grid.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            grid.classList.add('hidden');
            buildView.classList.remove('hidden');
            setTimeout(() => {
                buildView.classList.remove('opacity-0', 'translate-y-4');
                buildView.classList.add('opacity-100', 'translate-y-0');
            }, 50);
        }, 300);
        
        // Aquí llamarías a una función que busque en ENRICHED_DB[championName].buildData 
        // y pinte las imágenes en runes-content y items-content
    }

    // Manejo de Popup corregido
    const closeBtn = document.getElementById('close-popup');
    if (closeBtn) {
        closeBtn.onclick = () => {
            const popup = document.getElementById('reason-popup');
            if (popup) popup.classList.add('hidden');
        };
    }

    window.addEventListener('click', (event) => {
        const popup = document.getElementById('reason-popup');
        if (event.target === popup && popup) {
            popup.classList.add('hidden');
        }
    });

    // Iniciar
    console.log("🚀 HexDraft UI Ready");
    updateDraftStatus();
</script>