---
import Layout from '../layouts/Layout.astro';
---


<Layout title="HexDraft | LCU Real-Time">
    <main class="min-h-screen p-6 md:p-12 relative bg-[#010a13] text-slate-200">
        
        <div class="relative flex items-center mt-4 ">
            <a href="/" class="text-white/50 hover:text-white transition-colors z-10 text-sm mb-8 inline-block uppercase tracking-widest font-bold z-10">
                ← Volver al Inicio
            </a>
            <h2 class="absolute left-1/2 -translate-x-1/2 text-4xl md:text-6xl font-black mb-6 tracking-tight text-white">
                Tier<span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 via-hextech-gold to-purple-700">List</span>
            </h2>
            
        </div>
        <span class="flex justify-center">Version: 1.0.0</span>
        <div class="flex flex-wrap justify-center mt-2">
            <button 
                id="syncMetaBtn"
                class="flex px-3 py-3 gap-2 justify-center items-center bg-transparent text-white font-bold rounded-sm border border-slate-700 hover:bg-slate-800 transition-all uppercase tracking-widest text-sm cursor-pointer"
                >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 flex-justify-center items-center" id="syncIcon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                <span id="syncText">Sincronizar Meta</span>
            </button>
        </div>
    </div>
    </main>
</Layout>


<script>
  const btn = document.getElementById('syncMetaBtn');
  const text = document.getElementById('syncText');
  const icon = document.getElementById('syncIcon');

  btn?.addEventListener('click', async () => {
    btn.classList.add('opacity-50', 'pointer-events-none');
    text!.innerText = "Scrapeando OP.GG...";
    icon!.classList.add('animate-spin');

    try {
      const res = await fetch('/api/sync-meta', { method: 'POST' });
      if (res.ok) {
        text!.innerText = "¡Meta Actualizado!";
        setTimeout(() => {
          text!.innerText = "Sincronizar Meta";
          btn.classList.remove('opacity-50', 'pointer-events-none');
          icon!.classList.remove('animate-spin');
        }, 3000);
      }
    } catch (e) {
      text!.innerText = "Error al sincronizar";
    }
  });
</script>