---
// src/pages/settings.astro
import Layout from '../layouts/Layout.astro';
import { SettingsPage } from '../components/react/settings/SettingsPage';
---

<Layout title="HexDraft | Ajustes de Sistema">
  <main class="w-full h-full p-4 md:p-6 flex flex-col relative text-slate-200 overflow-x-hidden font-sans">
    <SettingsPage client:only="react" />
  </main>
</Layout>

<style is:global>
  /* Personalización extra para scrollbar de la consola */
  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: #050508;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: #23232f;
    border-radius: 3px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: #9055ff;
  }
</style>
