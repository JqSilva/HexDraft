---
import Layout from '../layouts/Layout.astro';
import { SyncPanel } from '../components/react/SyncPanel';
---

<Layout title="HexDraft | Panel de Control">
  <main class="min-h-screen p-4 md:p-8 relative text-slate-200 overflow-x-hidden font-sans">

    <header class="max-w-7xl mx-auto mb-10 flex justify-between items-center relative z-10">
      <div class="flex items-center gap-6">
        <a href="/" class="text-slate-400 hover:text-white transition-colors duration-200 text-xs uppercase tracking-[0.2em] font-black group cursor-pointer">
          <span class="inline-block transform group-hover:-translate-x-1.5 transition-transform duration-200">←</span> Inicio
        </a>
        <div class="h-6 w-px bg-border-warm"></div>
        <h1 class="text-lg md:text-2xl font-black uppercase tracking-[0.4em] text-white italic">
          Nexo <span class="text-[#9055ff]">Sincronización</span>
        </h1>
      </div>
      <div class="flex items-center gap-3 px-4 py-2 bg-panel-warm border border-border-warm rounded-sm select-none">
        <div class="w-2.5 h-2.5 rounded-full bg-[#9055ff] animate-pulse"></div>
        <span class="text-[9px] md:text-[10px] text-slate-300 font-black uppercase tracking-widest">Sistema Guard Activo</span>
      </div>
    </header>

    <!-- Componente React Inteligente -->
    <SyncPanel client:load />

  </main>
</Layout>