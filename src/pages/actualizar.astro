---
import Layout from '../layouts/Layout.astro';
---

<Layout title="HexDraft | Panel de Control">
  <main class="min-h-screen p-6 md:p-12 relative bg-[#010a13] text-slate-200 ">
    <header class="mb-2">
      <a href="/" class="text-white/50 hover:text-white transition-colors text-sm  inline-block uppercase tracking-widest font-bold">
        ← Volver al Inicio
      </a>
    </header>

    <h1 class="absolute left-1/2 -translate-x-1/2 text-4xl font-black italic uppercase tracking-tighter text-white">Base de Datos Engine</h1>
    
    <div class="flex flex-col justify-center mx-auto items-center  p-6 mt-8 mb-2 max-w-md">
        <label class="block text-sm font-bold uppercase text-slate-400">Versión del Parche Actual</label>
        <input type="text" id="patch-input" class=" p-3 w-48 text-xl text-center font-mono text-white focus:border-blue-500 outline-none transition-all" />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 max-w-4xl mx-auto">

      <div class="bg-slate-900 p-8 border border-slate-800 hover:border-blue-500/50 transition-all group">
        <div class="flex justify-between items-start mb-6">
          <h2 class="text-2xl font-bold text-white uppercase">Ciclo Corto</h2>
          <span class="bg-blue-500/10 text-blue-400 text-[10px] px-2 py-1 font-bold rounded">SEMANAL</span>
        </div>
        <ul class="text-sm text-slate-400 space-y-3 mb-8 h-32">
          <li class="flex gap-2"> <span class="text-blue-500">▹</span> Meta-Cache OP.GG (Master Tier)</li>
          <li class="flex gap-2"> <span class="text-blue-500">▹</span> Builds Óptimas e Ítems Core</li>
          <li class="flex gap-2"> <span class="text-blue-500">▹</span> Runas, Shards y Skill Order</li>
          <li class="flex gap-2"> <span class="text-blue-500">▹</span> God Matchups (Gold/XP Diff)</li>
        </ul>
        <button id="btn-short" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black py-4 uppercase tracking-widest cursor-pointer transition-all disabled:opacity-50">
          Sincronizar Meta
        </button>
      </div>

      <div class="bg-slate-900 p-8 border border-slate-800 hover:border-red-500/50 transition-all group">
        <div class="flex justify-between items-start mb-6">
          <h2 class="text-2xl font-bold text-white uppercase">Ciclo Largo</h2>
          <span class="bg-red-500/10 text-red-400 text-[10px] px-2 py-1 font-bold rounded">MENSUAL</span>
        </div>
        <ul class="text-sm text-slate-400 space-y-3 mb-8 h-32">
          <li class="flex gap-2"> <span class="text-red-500">▹</span> Mapa de Posiciones (Lanes)</li>
          <li class="flex gap-2"> <span class="text-red-500">▹</span> ADN: Composición de Daño</li>
          <li class="flex gap-2"> <span class="text-red-500">▹</span> Análisis de Scaling (Early/Late)</li>
          <li class="flex gap-2"> <span class="text-red-500">▹</span> Sinergias Históricas</li>
        </ul>
        <button id="btn-long" class="w-full border border-red-600 text-red-600 hover:bg-red-600 hover:text-white font-black py-4 uppercase tracking-widest cursor-pointer transition-all disabled:opacity-50">
          Reconstruir Core
        </button>
      </div>
    </div>

    <div class="bg-black border border-slate-800 p-4 rounded-sm shadow-2xl max-w-4xl mx-auto">
      <div class="flex justify-between items-center mb-2 border-b border-slate-800 pb-2">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Terminal Output</span>
        <div class="flex gap-1">
          <div class="w-2 h-2 rounded-full bg-red-500"></div>
          <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
          <div class="w-2 h-2 rounded-full bg-green-500"></div>
        </div>
      </div>
      <div id="terminal" class="h-64 overflow-y-auto font-mono text-xs p-2 text-green-500 space-y-1">
        <p class="text-slate-600">[SYSTEM] Esperando órdenes...</p>
      </div>
    </div>
  </main>
</Layout>

<script>

  async function autoDetectVersion() {
      try {
          const res = await fetch('/api/game-version');
          if (res.ok) {
              const data = await res.json();
              const input = document.getElementById('patch-input');
              input.value = data.short;
              document.getElementById('patch-input').value = data.short;
              writeToTerminal(`[LCU] Versión detectada automáticamente: ${data.short}`);
          } else {
              writeToTerminal(`[LCU] No se pudo detectar versión. Usando valor por defecto.`, 'warn');
          }
      } catch (e) {
          console.error("Error detectando versión:", e);
      }
  }

  // Llamar al inicio
  autoDetectVersion();

  function writeToTerminal(msg, type = 'info') {
    const terminal = document.getElementById('terminal');
    const p = document.createElement('p');
    const time = new Date().toLocaleTimeString();
    
    let color = 'text-green-500';
    if (type === 'warn') color = 'text-yellow-500';
    if (type === 'error') color = 'text-red-500';

    p.innerHTML = `<span class="text-slate-700">[${time}]</span> <span class="${color}">${msg}</span>`;
    terminal.appendChild(p);
    terminal.scrollTop = terminal.scrollHeight;
  }

  async function runSync(type) {
    const version = (document.getElementById('patch-input') as HTMLInputElement).value;
    const btn = document.getElementById(`btn-${type}`) as HTMLButtonElement;
    
    btn.disabled = true;
    writeToTerminal(`Iniciando Ciclo ${type.toUpperCase()}...`, 'warn');
    writeToTerminal(`Parámetro de versión: ${version}`);

    try {
      const res = await fetch(`/api/sync?type=${type}&version=${version}`);
      const data = await res.json();
      
      if (res.ok) {
        writeToTerminal(`PROCESO LANZADO: ${data.message}`);
        writeToTerminal(`Nota: El proceso corre en background del servidor. Revisa los logs de Node.`);
      } else {
        writeToTerminal(`ERROR: ${data.error}`, 'error');
      }
    } catch (e) {
      writeToTerminal(`FALLO DE RED: No se pudo contactar con la API`, 'error');
    } finally {
      // Re-habilitamos después de un pequeño delay para evitar spam
      setTimeout(() => btn.disabled = false, 50000);
    }
  }

  document.getElementById('btn-short').onclick = () => runSync('short');
  document.getElementById('btn-long').onclick = () => runSync('long');
</script>