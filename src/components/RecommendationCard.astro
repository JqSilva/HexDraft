---
// src/components/RecommendationCard.astro
import { ENRICHED_DB } from '../lib/engine/dataProvider';

interface Props {
  recommendation: {
    id: number;
    name: string;
    score: number;
    reasons: string[];
  };
}

const { recommendation } = Astro.props;
// Aquí es donde "unimos" la recomendación del engine con la data completa del JSON
const details = ENRICHED_DB[recommendation.name];
---

<div class="champion-card" data-champion={recommendation.name}>
  <div class="card-header">
    <span class="champ-name">{recommendation.name}</span>
    <span class="score-badge">{recommendation.score}</span>
  </div>

  {details && (
    <div class="composition-info">
      <div class="tags">
        {details.tags.map(tag => <span class="tag">{tag}</span>)}
        <span class={`scaling-tag ${details.scalingType.toLowerCase()}`}>
          {details.scalingType}
        </span>
      </div>

      <div class="damage-bar">
        <div class="phys" style={`width: ${details.combat.damageComposition.physical}%`}></div>
        <div class="magic" style={`width: ${details.combat.damageComposition.magic}%`}></div>
        <div class="true" style={`width: ${details.combat.damageComposition.true}%`}></div>
      </div>
    </div>
  )}

  <ul class="reasons-list">
    {recommendation.reasons.map(reason => (
      <li class={reason.toLowerCase().includes('counter') ? 'negative' : 'positive'}>
        {reason}
      </li>
    ))}
  </ul>
</div>

<style>
  /* Aquí pones tus estilos para que se vea prolijo */
  .damage-bar { display: flex; height: 6px; background: #333; border-radius: 3px; overflow: hidden; margin: 10px 0; }
  .phys { background: #d97706; }
  .magic { background: #3b82f6; }
  .true { background: #fff; }
  .positive { color: #4ade80; font-size: 0.85rem; }
  .negative { color: #f87171; font-size: 0.85rem; }
</style>