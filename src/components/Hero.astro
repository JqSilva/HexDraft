---
---
<section class="flex justify-center items-center py-20 overflow-hidden w-full min-h-screen">
  <!-- Efecto de luces de fondo -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-from)_0%,_transparent_70%)] from-purple-900/20 to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-4 relative z-10 text-center">
    <h2 class="text-6xl md:text-9xl font-black mb-6 tracking-tight text-white">
      Hex<span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 via-hextech-gold to-purple-700">Draft</span>
    </h2>
    <p class="text-slate-400 max-w-2xl mx-auto text-lg mb-10">
        Herramienta para draft en League of Legends
    </p>
    
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/draft" class="px-8 py-3 bg-purple-600 text-hextech-dark font-bold rounded-sm hover:brightness-110 transition-all uppercase tracking-widest text-sm border-b-2 border-yellow-800 cursor-pointer">
        Comenzar
      </a>
      <a href="/actualizar" class="px-8 py-3 bg-transparent text-white font-bold rounded-sm border border-slate-700 hover:bg-slate-800 transition-all uppercase tracking-widest text-sm cursor-pointer">
        Actualizar
      </a>
    </div>
  </div>
</section>