---
// src/components/Sidebar.astro
import ChampionsIcon from "../assets/champions.svg";
import { appConfig } from "../lib/services/config.service.js";
const activePath = Astro.url.pathname;
---

<aside
  id="sidebar"
  transition:persist
  class="h-screen bg-bg-warm border-r border-border-warm flex flex-col justify-between p-3 md:p-4 transition-all duration-300 w-60 select-none shrink-0 relative z-20 overflow-hidden"
>
  <div id="sidebar-expanded-content" class="h-full flex flex-col justify-between transition-all duration-300">
  <!-- Top / Logo and Navigation -->
  <div class="flex flex-col gap-6">
    <!-- Brand Header -->
    <div id="brand-header" class="flex items-center justify-between h-10">
      <a
        href="/dashboard"
        id="sidebar-logo-link"
        class="flex items-center gap-3 overflow-hidden transition-all duration-300"
      >
        <!-- Brand mark, intentionally transparent so the logo belongs to the shell. -->
        <img
          id="logo-hexdraft"
          src="/favicon.svg"
          alt="HexDraft"
          class="w-10 h-10 object-contain shrink-0"
        />
        <!-- Logo Text -->
        <div
          id="sidebar-logo-text"
          class="text-left whitespace-nowrap transition-all duration-300"
        >
          <span
            class="text-base font-semibold tracking-[-0.02em] text-white"
            >Hex<span class="text-purple-accent">Draft</span></span
          >
          <span
            class="block text-[8px] text-slate-400 uppercase tracking-[0.14em] font-semibold leading-none"
            >Análisis Composición</span
          >
        </div>
      </a>

      <!-- Collapse Toggle Button -->
      <button
        id="sidebar-toggle-btn"
        data-sidebar-toggle
        aria-label="Contraer navegación"
        aria-expanded="true"
        class="btn-quiet inline-flex min-h-11 min-w-11 items-center justify-center p-2 text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer shrink-0 leading-none"
      >
        <svg
          id="toggle-icon-arrow"
          class="block w-4 h-4 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex flex-col gap-1 w-full">
      <a
        href="/"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-lg text-sm leading-5 font-semibold transition-all duration-200 ${activePath === "/" ? "bg-purple-accent/10 text-white ring-1 ring-inset ring-purple-accent/30" : "text-slate-300 hover:text-white hover:bg-white/[0.03]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
          ></path>
        </svg>
        <span class="sidebar-text transition-all duration-200">Inicio</span>
      </a>

      <a
        href="/dashboard"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-lg text-sm leading-5 font-semibold transition-all duration-200 ${activePath === "/dashboard" ? "bg-purple-accent/10 text-white ring-1 ring-inset ring-purple-accent/30" : "text-slate-300 hover:text-white hover:bg-white/[0.03]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
          ></path>
        </svg>
        <span class="sidebar-text transition-all duration-200"
          >Panel General</span
        >
      </a>

      <a
        href="/history"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-lg text-sm leading-5 font-semibold transition-all duration-200 ${activePath === "/history" ? "bg-purple-accent/10 text-white ring-1 ring-inset ring-purple-accent/30" : "text-slate-300 hover:text-white hover:bg-white/[0.03]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89l.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7s-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.95 8.95 0 0 0 13 21a9 9 0 0 0 0-18m-1 5v5l4.28 2.54l.72-1.21l-3.5-2.08V8z"
          ></path></svg
        >
        <span class="sidebar-text transition-all duration-200">Historial</span>
      </a>

      <a
        href="/champions"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-lg text-sm leading-5 font-semibold transition-all duration-200 ${activePath === "/champions" ? "bg-purple-accent/10 text-white ring-1 ring-inset ring-purple-accent/30" : "text-slate-300 hover:text-white hover:bg-white/[0.03]"}`}
      >
        <ChampionsIcon class="w-5 h-5"/>
        <span class="sidebar-text transition-all duration-200">Campeones</span>
      </a>

      <a
        href="/draft"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-lg text-sm leading-5 font-semibold transition-all duration-200 ${activePath === "/draft" ? "bg-purple-accent/10 text-white ring-1 ring-inset ring-purple-accent/30" : "text-slate-300 hover:text-white hover:bg-white/[0.03]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"
          ></path>
        </svg>
        <span class="sidebar-text transition-all duration-200"
          >Draft en Vivo</span
        >
      </a>

      {appConfig.mode === 'admin' && (
        <a
          href="/actualizar"
          class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-lg text-sm leading-5 font-semibold transition-all duration-200 ${activePath === "/actualizar" ? "bg-purple-accent/10 text-white ring-1 ring-inset ring-purple-accent/30" : "text-slate-300 hover:text-white hover:bg-white/[0.03]"}`}
        >
          <svg
            class="w-4 h-4 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
            ></path>
          </svg>
          <span class="sidebar-text transition-all duration-200"
            >Sincronización</span
          >
          <span id="sidebar-sync-badge" class="hidden w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 ml-auto" title="Actualización recomendada"></span>
        </a>
      )}

      <a
        href="/settings"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-lg text-sm leading-5 font-semibold transition-all duration-200 ${activePath === "/settings" ? "bg-purple-accent/10 text-white ring-1 ring-inset ring-purple-accent/30" : "text-slate-300 hover:text-white hover:bg-white/[0.03]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.43l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="sidebar-text transition-all duration-200">Ajustes</span>
      </a>
    </nav>
  </div>

  <!-- Bottom / Level and XP bar -->
  <div
    id="sidebar-level-section"
    class="border-t border-border-warm pt-4 transition-all duration-300 overflow-hidden shrink-0 h-[76px]"
  >
    <!-- Ícono colapsado (solo visible en modo compacto) -->
    <div
      id="sidebar-collapsed-icon"
      class="hidden justify-center items-center w-full h-[56px]"
    >
      <div
        class="w-8 h-8 flex items-center justify-center"
      >
        <img
          src="/favicon.svg"
          alt="HexDraft"
          class="w-full h-full object-contain"
        />
      </div>
    </div>

    <!-- XP tracker (visible en modo expandido) -->
    <div id="sidebar-xp-tracker">
      <div class="flex justify-between items-center mb-1">
        <span
          class="text-xs font-medium tracking-wide text-purple-accent"
          >Nivel <span id="sidebar-level-val">128</span></span
        >
        <span id="sidebar-xp-pct" class="text-[10px] font-mono text-slate-400 leading-none"
          >43%</span
        >
      </div>
      <div
        class="w-full bg-input-warm h-1.5 rounded-full overflow-hidden border border-border-warm relative"
      >
        <div
          id="sidebar-level-fill"
          class="bg-purple-accent h-full rounded-full transition-all duration-500 ease-out"
          style="width: 43%"
        >
        </div>
      </div>
      <div class="flex justify-between items-center mt-1.5">
        <span
          class="text-[8px] uppercase tracking-[0.12em] font-semibold text-slate-500 leading-none"
          >PROGRESO XP</span
        >
        <span
          id="sidebar-xp-vals"
          class="text-[8px] font-mono font-bold text-slate-400 leading-none"
          >12,450 / 28,950 XP</span
        >
      </div>
    </div>
  </div>
  </div>

  <!-- Compact face: remains spatially stable while the expanded face fades out. -->
  <div id="sidebar-compact-content" aria-hidden="true" class="sidebar-compact-content">
    <div class="flex flex-col items-center gap-3">
      <a href="/dashboard" aria-label="Ir al panel general" title="Panel general" class="w-11 h-11 flex items-center justify-center">
        <img src="/favicon.svg" alt="HexDraft" class="w-10 h-10 object-contain" />
      </a>
      <button
        id="sidebar-compact-toggle-btn"
        data-sidebar-toggle
        type="button"
        aria-label="Expandir navegación"
        aria-expanded="false"
        title="Expandir navegación"
        class="btn-quiet inline-flex min-h-11 min-w-11 items-center justify-center p-2 text-slate-500 hover:text-white transition-colors duration-200 cursor-pointer leading-none"
      >
        <svg class="block w-4 h-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Navegación compacta" class="flex flex-1 flex-col items-center gap-1.5 mt-5 pt-4 border-t border-border-warm">
      <a href="/" title="Inicio" aria-label="Inicio" class={`sidebar-compact-item ${activePath === "/" ? "is-active" : ""}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" /></svg>
      </a>
      <a href="/dashboard" title="Panel general" aria-label="Panel general" class={`sidebar-compact-item ${activePath === "/dashboard" ? "is-active" : ""}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.75" y="3.75" width="7" height="7" rx="2" /><rect x="13.25" y="3.75" width="7" height="7" rx="2" /><rect x="3.75" y="13.25" width="7" height="7" rx="2" /><rect x="13.25" y="13.25" width="7" height="7" rx="2" /></svg>
      </a>
      <a href="/history" title="Historial" aria-label="Historial" class={`sidebar-compact-item ${activePath === "/history" ? "is-active" : ""}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5M12 7v5l3 2" /></svg>
      </a>
      <a href="/champions" title="Campeones" aria-label="Campeones" class={`sidebar-compact-item ${activePath === "/champions" ? "is-active" : ""}`}>
        <ChampionsIcon class="w-5 h-5" />
      </a>
      <a href="/draft" title="Draft en vivo" aria-label="Draft en vivo" class={`sidebar-compact-item ${activePath === "/draft" ? "is-active" : ""}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" /></svg>
      </a>
      {appConfig.mode === 'admin' && (
        <a href="/actualizar" title="Sincronización" aria-label="Sincronización" class={`sidebar-compact-item sidebar-compact-item--sync ${activePath === "/actualizar" ? "is-active" : ""}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 10a8.5 8.5 0 0 0-14.8-4.7L3.5 7.5" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 3.5v4h4" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 14a8.5 8.5 0 0 0 14.8 4.7l2.2-2.2" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 20.5v-4h-4" />
          </svg>
        </a>
      )}
      <a href="/settings" title="Ajustes" aria-label="Ajustes" class={`sidebar-compact-item sidebar-compact-item--settings ${activePath === "/settings" ? "is-active" : ""}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <circle cx="12" cy="12" r="3.25" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.43 15a1.65 1.65 0 0 0 .33 1.83l.06.06-1.82 1.82-.06-.06a1.65 1.65 0 0 0-1.83-.33 1.65 1.65 0 0 0-1 1.52V20h-2.22v-.16a1.65 1.65 0 0 0-1-1.52 1.65 1.65 0 0 0-1.83.33L10 18.7l-1.82-1.82.06-.06A1.65 1.65 0 0 0 8.57 15a1.65 1.65 0 0 0-1.52-1H6.9v-2.22h.15a1.65 1.65 0 0 0 1.52-1 1.65 1.65 0 0 0-.33-1.83l-.06-.06L10 7.07l.06.06a1.65 1.65 0 0 0 1.83.33 1.65 1.65 0 0 0 1-1.52V5.8h2.22v.14a1.65 1.65 0 0 0 1 1.52 1.65 1.65 0 0 0 1.83-.33L18 7.07l1.82 1.82-.06.06a1.65 1.65 0 0 0-.33 1.83 1.65 1.65 0 0 0 1.52 1h.15V14h-.15a1.65 1.65 0 0 0-1.52 1Z" />
        </svg>
      </a>
    </nav>

    <div class="pt-4 flex justify-center">
      <span class="w-1.5 h-1.5 rounded-full bg-violet-solid" title="HexDraft activo"></span>
    </div>
  </div>
</aside>

<script>
  const sidebar = document.getElementById("sidebar");
  const toggleBtn = document.getElementById("sidebar-toggle-btn");
  const compactToggleBtn = document.getElementById("sidebar-compact-toggle-btn");
  const toggleIcon = document.getElementById("toggle-icon-arrow");
  const xpTracker = document.getElementById("sidebar-xp-tracker");
  const collapsedIcon = document.getElementById("sidebar-collapsed-icon");
  const expandedView = document.getElementById("sidebar-expanded-content");
  const compactView = document.getElementById("sidebar-compact-content");

  function updateSidebarState(isCollapsed: boolean) {
    if (!sidebar || !toggleIcon || !xpTracker || !collapsedIcon || !expandedView || !compactView) return;
    toggleBtn?.setAttribute("aria-expanded", String(!isCollapsed));
    toggleBtn?.setAttribute("aria-label", isCollapsed ? "Expandir navegación" : "Contraer navegación");
    compactToggleBtn?.setAttribute("aria-expanded", String(!isCollapsed));
    compactToggleBtn?.setAttribute("aria-label", isCollapsed ? "Expandir navegación" : "Contraer navegación");
    compactToggleBtn?.setAttribute("title", isCollapsed ? "Expandir navegación" : "Contraer navegación");
    expandedView.setAttribute("aria-hidden", String(isCollapsed));
    compactView.setAttribute("aria-hidden", String(!isCollapsed));

    if (isCollapsed) {
      sidebar.classList.add("collapsed");

      // Bottom: ocultar XP, mostrar ícono
      xpTracker.style.display = "none";
      collapsedIcon.style.display = "flex";

      toggleIcon.style.transform = "rotate(180deg)";
    } else {
      sidebar.classList.remove("collapsed");

      // Bottom: mostrar XP, ocultar ícono
      xpTracker.style.display = "block";
      collapsedIcon.style.display = "none";

      toggleIcon.style.transform = "rotate(0deg)";
    }
  }

  function updateActiveLink() {
    const currentPath = window.location.pathname;
    const items = document.querySelectorAll(".sidebar-item");
    items.forEach((item) => {
      const href = item.getAttribute("href");
      const isActive =
        href === "/"
          ? currentPath === "/"
          : href
            ? currentPath === href || currentPath.startsWith(href + "/")
            : false;

      if (isActive) {
        item.classList.add(
          "bg-purple-accent/10",
          "text-white",
          "ring-1",
          "ring-inset",
          "ring-purple-accent/30",
        );
        item.classList.remove(
          "text-slate-300",
          "hover:text-white",
          "hover:bg-white/[0.02]",
        );
      } else {
        item.classList.remove(
          "bg-purple-accent/10",
          "text-white",
          "ring-1",
          "ring-inset",
          "ring-purple-accent/30",
        );
        item.classList.add(
          "text-slate-300",
          "hover:text-white",
          "hover:bg-white/[0.02]",
        );
      }
    });

    const compactItems = document.querySelectorAll(".sidebar-compact-item");
    compactItems.forEach((item) => {
      const href = item.getAttribute("href");
      const isActive =
        href === "/"
          ? currentPath === "/"
          : href
            ? currentPath === href || currentPath.startsWith(href + "/")
            : false;
      item.classList.toggle("is-active", isActive);
    });
  }

  let collapsed = localStorage.getItem("sidebar-collapsed") === "true";
  updateSidebarState(collapsed);

  const toggleSidebar = () => {
    collapsed = !collapsed;
    localStorage.setItem("sidebar-collapsed", String(collapsed));
    updateSidebarState(collapsed);
  };

  toggleBtn?.addEventListener("click", toggleSidebar);
  compactToggleBtn?.addEventListener("click", toggleSidebar);

  async function fetchSidebarProfile() {
    try {
      const res = await fetch("/api/me");
      if (res.ok) {
        const data = await res.json();
        const levelVal = document.getElementById("sidebar-level-val");
        const xpPct = document.getElementById("sidebar-xp-pct");
        const levelFill = document.getElementById("sidebar-level-fill");
        const xpVals = document.getElementById("sidebar-xp-vals");

        if (levelVal) levelVal.textContent = data.level;
        if (xpPct) xpPct.textContent = `${data.xpPercent}%`;
        if (levelFill) levelFill.style.width = `${data.xpPercent}%`;
        if (xpVals)
          xpVals.textContent = `${data.xpCurrent.toLocaleString()} / ${data.xpMax.toLocaleString()} XP`;

        // Control del badge de recomendación de actualización
        const badge = document.getElementById("sidebar-sync-badge");
        if (badge) {
          if (data.syncRecommended) {
            badge.classList.remove("hidden");
          } else {
            badge.classList.add("hidden");
          }
        }
      }
    } catch (e) {
      console.warn("Could not poll stats dynamically for Sidebar profile:", e);
    }
  }

  // Initial updates
  updateActiveLink();
  fetchSidebarProfile();

  // Listeners and intervals
  document.addEventListener("astro:page-load", () => {
    updateActiveLink();
  });
  setInterval(fetchSidebarProfile, 4000);
</script>

