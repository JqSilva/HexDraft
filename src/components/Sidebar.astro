---
// src/components/Sidebar.astro
import ChampionsIcon from "../assets/champions.svg";
import { appConfig } from "../lib/services/config.service.js";
const activePath = Astro.url.pathname;
---

<aside
  id="sidebar"
  transition:persist
  class="h-screen bg-[#0a0a0d] border-r border-[#1b1b1f] flex flex-col justify-between p-4 transition-all duration-300 w-64 select-none shrink-0 relative z-20 overflow-hidden"
>
  <!-- Top / Logo and Navigation -->
  <div class="flex flex-col gap-6">
    <!-- Brand Header -->
    <div id="brand-header" class="flex items-center justify-between h-10">
      <a
        href="/dashboard"
        id="sidebar-logo-link"
        class="flex items-center gap-3 overflow-hidden transition-all duration-300"
      >
        <!-- Hood/Assassin App Icon -->
        <div
          id="logo-hexdraft"
          class="relative w-10 h-10 flex items-center justify-center rounded-lg shadow-[0_0_15px_rgba(144,85,255,0.2)] shrink-0"
        >
          <img
            src="/favicon.svg"
            alt="Hood-icon"
            class="w-full h-full object-cover rounded-lg"
          />
        </div>
        <!-- Logo Text -->
        <div
          id="sidebar-logo-text"
          class="text-left whitespace-nowrap transition-all duration-300"
        >
          <span
            class="text-base font-black uppercase tracking-[0.2em] text-white"
            >Hex<span class="text-[#9055ff]">Draft</span></span
          >
          <span
            class="block text-[7px] text-slate-400 uppercase tracking-widest font-semibold"
            >Análisis Composición</span
          >
        </div>
      </a>

      <!-- Collapse Toggle Button -->
      <button
        id="sidebar-toggle-btn"
        class="p-1.5 rounded bg-[#15151e]/80 border border-[#1b1b1f] text-slate-400 hover:text-white hover:border-[#9055ff]/40 transition-colors duration-200 cursor-pointer shrink-0"
      >
        <svg
          id="toggle-icon-arrow"
          class="w-4 h-4 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex flex-col gap-1 w-full">
      <a
        href="/"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-md text-[11px] uppercase tracking-wider font-bold transition-all duration-300 ${activePath === "/" ? "bg-[#9055ff]/20 text-white shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]" : "text-slate-400 hover:text-white hover:bg-white/[0.02]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
          ></path>
        </svg>
        <span class="sidebar-text transition-all duration-200">Inicio</span>
      </a>

      <a
        href="/dashboard"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-md text-[11px] uppercase tracking-wider font-bold transition-all duration-300 ${activePath === "/dashboard" ? "bg-[#9055ff]/20 text-white shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]" : "text-slate-400 hover:text-white hover:bg-white/[0.02]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
          ></path>
        </svg>
        <span class="sidebar-text transition-all duration-200"
          >Panel General</span
        >
      </a>

      <a
        href="/history"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-md text-[11px] uppercase tracking-wider font-bold transition-all duration-300 ${activePath === "/history" ? "bg-[#9055ff]/20 text-white shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]" : "text-slate-400 hover:text-white hover:bg-white/[0.02]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89l.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7s-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.95 8.95 0 0 0 13 21a9 9 0 0 0 0-18m-1 5v5l4.28 2.54l.72-1.21l-3.5-2.08V8z"
          ></path></svg
        >
        <span class="sidebar-text transition-all duration-200">Historial</span>
      </a>

      <a
        href="/champions"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-md text-[11px] uppercase tracking-wider font-bold transition-all duration-300 ${activePath === "/champions" ? "bg-[#9055ff]/20 text-white shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]" : "text-slate-400 hover:text-white hover:bg-white/[0.02]"}`}
      >
        <ChampionsIcon class="w-5 h-5"/>
        <span class="sidebar-text transition-all duration-200">Campeones</span>
      </a>

      <a
        href="/draft"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-md text-[11px] uppercase tracking-wider font-bold transition-all duration-300 ${activePath === "/draft" ? "bg-[#9055ff]/20 text-white shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]" : "text-slate-400 hover:text-white hover:bg-white/[0.02]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"
          ></path>
        </svg>
        <span class="sidebar-text transition-all duration-200"
          >Draft en Vivo</span
        >
      </a>

      {appConfig.mode === 'admin' && (
        <a
          href="/actualizar"
          class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-md text-[11px] uppercase tracking-wider font-bold transition-all duration-300 ${activePath === "/actualizar" ? "bg-[#9055ff]/20 text-white shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]" : "text-slate-400 hover:text-white hover:bg-white/[0.02]"}`}
        >
          <svg
            class="w-4 h-4 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
            ></path>
          </svg>
          <span class="sidebar-text transition-all duration-200"
            >Sincronización</span
          >
          <span id="sidebar-sync-badge" class="hidden w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 ml-auto" title="Actualización recomendada"></span>
        </a>
      )}

      <a
        href="/settings"
        class={`sidebar-item flex items-center gap-3 px-3 py-3 rounded-md text-[11px] uppercase tracking-wider font-bold transition-all duration-300 ${activePath === "/settings" ? "bg-[#9055ff]/20 text-white shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]" : "text-slate-400 hover:text-white hover:bg-white/[0.02]"}`}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.43l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="sidebar-text transition-all duration-200">Ajustes</span>
      </a>
    </nav>
  </div>

  <!-- Bottom / Level and XP bar -->
  <div
    id="sidebar-level-section"
    class="border-t border-[#1b1b1f] pt-4 transition-all duration-300 overflow-hidden shrink-0 h-[72px]"
  >
    <!-- Ícono colapsado (solo visible en modo compacto) -->
    <div
      id="sidebar-collapsed-icon"
      class="hidden justify-center items-center w-full h-[56px]"
    >
      <div
        class="w-8 h-8 flex items-center justify-center"
      >
        <img
          src="/favicon.svg"
          alt="Hood-icon"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- XP tracker (visible en modo expandido) -->
    <div id="sidebar-xp-tracker">
      <div class="flex justify-between items-center mb-1">
        <span
          class="text-[10px] uppercase font-bold tracking-widest text-[#9055ff]"
          >Nivel <span id="sidebar-level-val">128</span></span
        >
        <span id="sidebar-xp-pct" class="text-[9px] font-mono text-slate-400"
          >43%</span
        >
      </div>
      <div
        class="w-full bg-[#15151a] h-1.5 rounded-full overflow-hidden border border-[#22222b] relative"
      >
        <div
          id="sidebar-level-fill"
          class="bg-gradient-to-r from-[#9055ff] to-purple-400 h-full rounded-full transition-all duration-1000 ease-out shadow-[0_0_8px_rgba(144,85,255,0.7)]"
          style="width: 43%"
        >
        </div>
      </div>
      <div class="flex justify-between items-center mt-1.5">
        <span
          class="text-[7px] uppercase tracking-wider font-semibold text-slate-500"
          >PROGRESO XP</span
        >
        <span
          id="sidebar-xp-vals"
          class="text-[7px] font-mono font-bold text-slate-400"
          >12,450 / 28,950 XP</span
        >
      </div>
    </div>
  </div>
</aside>

<script>
  const sidebar = document.getElementById("sidebar");
  const toggleBtn = document.getElementById("sidebar-toggle-btn");
  const toggleIcon = document.getElementById("toggle-icon-arrow");
  const xpTracker = document.getElementById("sidebar-xp-tracker");
  const collapsedIcon = document.getElementById("sidebar-collapsed-icon");

  function updateSidebarState(isCollapsed: boolean) {
    if (!sidebar || !toggleIcon || !xpTracker || !collapsedIcon) return;

    if (isCollapsed) {
      sidebar.classList.add("collapsed");

      // Bottom: ocultar XP, mostrar ícono
      xpTracker.style.display = "none";
      collapsedIcon.style.display = "flex";

      toggleIcon.style.transform = "rotate(180deg)";
    } else {
      sidebar.classList.remove("collapsed");

      // Bottom: mostrar XP, ocultar ícono
      xpTracker.style.display = "block";
      collapsedIcon.style.display = "none";

      toggleIcon.style.transform = "rotate(0deg)";
    }
  }

  function updateActiveLink() {
    const currentPath = window.location.pathname;
    const items = document.querySelectorAll(".sidebar-item");
    items.forEach((item) => {
      const href = item.getAttribute("href");
      const isActive =
        href === "/"
          ? currentPath === "/"
          : href
            ? currentPath === href || currentPath.startsWith(href + "/")
            : false;

      if (isActive) {
        item.classList.add(
          "bg-[#9055ff]/20",
          "text-white",
          "shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]",
        );
        item.classList.remove(
          "text-slate-400",
          "hover:text-white",
          "hover:bg-white/[0.02]",
        );
      } else {
        item.classList.remove(
          "bg-[#9055ff]/20",
          "text-white",
          "shadow-[inset_4px_0_12px_rgba(144,85,255,0.08)]",
        );
        item.classList.add(
          "text-slate-400",
          "hover:text-white",
          "hover:bg-white/[0.02]",
        );
      }
    });
  }

  let collapsed = localStorage.getItem("sidebar-collapsed") === "true";
  updateSidebarState(collapsed);

  toggleBtn?.addEventListener("click", () => {
    collapsed = !collapsed;
    localStorage.setItem("sidebar-collapsed", String(collapsed));
    updateSidebarState(collapsed);
  });

  async function fetchSidebarProfile() {
    try {
      const res = await fetch("/api/me");
      if (res.ok) {
        const data = await res.json();
        const levelVal = document.getElementById("sidebar-level-val");
        const xpPct = document.getElementById("sidebar-xp-pct");
        const levelFill = document.getElementById("sidebar-level-fill");
        const xpVals = document.getElementById("sidebar-xp-vals");

        if (levelVal) levelVal.textContent = data.level;
        if (xpPct) xpPct.textContent = `${data.xpPercent}%`;
        if (levelFill) levelFill.style.width = `${data.xpPercent}%`;
        if (xpVals)
          xpVals.textContent = `${data.xpCurrent.toLocaleString()} / ${data.xpMax.toLocaleString()} XP`;

        // Control del badge de recomendación de actualización
        const badge = document.getElementById("sidebar-sync-badge");
        if (badge) {
          if (data.syncRecommended) {
            badge.classList.remove("hidden");
          } else {
            badge.classList.add("hidden");
          }
        }
      }
    } catch (e) {
      console.warn("Could not poll stats dynamically for Sidebar profile:", e);
    }
  }

  // Initial updates
  updateActiveLink();
  fetchSidebarProfile();

  // Listeners and intervals
  document.addEventListener("astro:page-load", () => {
    updateActiveLink();
  });
  setInterval(fetchSidebarProfile, 4000);
</script>

<style>
  /* Base transitions */
  #sidebar {
    transition:
      width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-item {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  /* Smooth text scale/opacity transition to prevent wrapping */
  .sidebar-text {
    display: inline-block;
    white-space: nowrap;
    overflow: hidden;
    max-width: 150px;
    opacity: 1;
    transition:
      max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Logo text container transition */
  #sidebar-logo-text {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    overflow: hidden;
    max-width: 150px;
    opacity: 1;
    transition:
      max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Collapsed layout overrides */
  #sidebar.collapsed {
    width: 4rem !important; /* w-16 */
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
  }

  #sidebar.collapsed #sidebar-logo-link {
    display: none;
  }

  #sidebar.collapsed #brand-header {
    justify-content: center;
  }

  #sidebar.collapsed .sidebar-item {
    justify-content: center;
    padding-left: 0 !important;
    padding-right: 0 !important;
    width: 2.5rem !important; /* w-10 (40px) */
    height: 2.5rem !important; /* h-10 (40px) */
    gap: 0 !important; /* Disables flex gap so the icon is centered perfectly */
  }

  #sidebar.collapsed .sidebar-text {
    max-width: 0;
    opacity: 0;
    pointer-events: none;
  }

  #sidebar.collapsed #sidebar-logo-text {
    max-width: 0;
    opacity: 0;
    pointer-events: none;
  }

  #sidebar.collapsed #sidebar-sync-badge {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    margin-left: 0 !important;
  }
</style>
